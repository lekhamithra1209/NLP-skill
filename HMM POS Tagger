import nltk
import math
from collections import defaultdict, Counter

nltk.download('udhr')

from nltk.corpus import udhr

text = udhr.words('English-Latin1')

sentences = []

for i in range(0, len(text), 10):
    sentence = text[i:i+10]
    if len(sentence) > 1:
        sentences.append([(word.lower(), 'NOUN') for word in sentence])

split = int(len(sentences) * 0.8)

train_data = sentences[:split]
test_data = sentences[split:]

transition_counts = defaultdict(Counter)
emission_counts = defaultdict(Counter)
tag_counts = Counter()

for sentence in train_data:
    previous_tag = "<START>"

    for word, tag in sentence:
        transition_counts[previous_tag][tag] += 1
        emission_counts[tag][word] += 1
        tag_counts[tag] += 1
        previous_tag = tag

    transition_counts[previous_tag]["<END>"] += 1

transition_prob = defaultdict(dict)
emission_prob = defaultdict(dict)

for previous_tag in transition_counts:
    total = sum(transition_counts[previous_tag].values())

    for tag in transition_counts[previous_tag]:
        transition_prob[previous_tag][tag] = (
            transition_counts[previous_tag][tag] / total
        )

for tag in emission_counts:
    total = tag_counts[tag]

    for word in emission_counts[tag]:
        emission_prob[tag][word] = (
            emission_counts[tag][word] / total
        )

tags = list(tag_counts.keys())

def viterbi(words):
    viterbi_table = [{}]
    backpointer = [{}]

    for tag in tags:
        transition = transition_prob["<START>"].get(tag, 1e-6)
        emission = emission_prob[tag].get(words[0], 1e-6)

        viterbi_table[0][tag] = math.log(transition) + math.log(emission)
        backpointer[0][tag] = None

    for i in range(1, len(words)):
        viterbi_table.append({})
        backpointer.append({})

        for tag in tags:
            emission = emission_prob[tag].get(words[i], 1e-6)

            best_previous = None
            best_score = float("-inf")

            for previous_tag in tags:
                transition = transition_prob[previous_tag].get(tag, 1e-6)

                score = (
                    viterbi_table[i - 1][previous_tag]
                    + math.log(transition)
                    + math.log(emission)
                )

                if score > best_score:
                    best_score = score
                    best_previous = previous_tag

            viterbi_table[i][tag] = best_score
            backpointer[i][tag] = best_previous

    best_tag = max(
        viterbi_table[-1],
        key=viterbi_table[-1].get
    )

    best_path = [best_tag]

    for i in range(len(words) - 1, 0, -1):
        best_tag = backpointer[i][best_tag]
        best_path.append(best_tag)

    best_path.reverse()

    return best_path

correct = 0
total = 0

for sentence in test_data:
    words = [word for word, tag in sentence]
    actual_tags = [tag for word, tag in sentence]

    predicted_tags = viterbi(words)

    for actual, predicted in zip(actual_tags, predicted_tags):
        if actual == predicted:
            correct += 1
        total += 1

accuracy = (correct / total) * 100

print("Test Dataset POS Tagging Accuracy:",
      round(accuracy, 2), "%")

sentence = input("\nEnter a sentence: ")

words = sentence.lower().split()
predicted_tags = viterbi(words)

print("\nPOS Tags:")

for word, tag in zip(words, predicted_tags):
    print(word, "->", tag)

print("\nEvaluation Report")
print("Correct Tags:", correct)
print("Total Tags:", total)
print("Accuracy:", round(accuracy, 2), "%")
